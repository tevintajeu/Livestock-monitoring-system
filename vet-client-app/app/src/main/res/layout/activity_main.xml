<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background">

    <!-- Top AppBar: Brand Header + Active Role Switcher + Guided Boma Box Sync Card -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_navy"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">

        <!-- Custom Top Bar with Role Badge & Quick Switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minHeight="32dp"
                    app:contentInsetStart="0dp"
                    app:title="MifugoSafe"
                    app:titleTextColor="@color/white" />

                <TextView
                    android:id="@+id/tv_app_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Smart Herd &amp; Vet Monitor • Offline Ready"
                    android:textColor="@color/surface_divider"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 1-Tap Role Switch Badge (Long-press opens Gateway IP Config) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_role_switch"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="👨🏾‍🌾 Mode: Herder"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="24dp"
                android:backgroundTint="@color/status_healthy"
                android:textColor="@color/white" />

            <!-- Vet IP Settings Button (Visible in Vet Mode) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_vet_ip_settings"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:text="⚙️"
                android:textSize="18sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Wipe / Clean Slate Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_all_cows"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="🗑️"
                android:textSize="16sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="Clear All Animals" />

            <!-- Lock / Switch PIN Screen Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_lock_session"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="🔒"
                android:textSize="16sp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>

        <!-- Guided "Boma Box" Sync Banner Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layout_gateway_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Status Row + Need Help Link -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/img_gateway_status"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_wifi_gateway"
                        app:tint="@color/status_healthy"
                        android:contentDescription="Boma Box Status" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_boma_box_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Boma Receiver: Ready to Sync"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <!-- Technical Gateway Endpoint (Hidden in Farmer Mode, Shown in Vet Mode) -->
                        <TextView
                            android:id="@+id/tv_gateway_endpoint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Target: http://192.168.4.1/data"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_need_help_connecting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="6dp"
                        android:text="❓ Need Help?"
                        android:textColor="@color/primary_navy"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_metric_pill" />
                </LinearLayout>

                <!-- Primary 56dp CTA Sync Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sync_gateway"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/btn_sync_now"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    app:cornerRadius="12dp"
                    android:backgroundTint="@color/cta_sync_teal"
                    android:textColor="@color/white" />

                <!-- Triage Summary Strip (Hidden counters kept for backward compatibility + visual summary) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Herd Summary: "
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_count_total_nodes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Cows  •  "
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_count_anomaly_nodes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2"
                        android:textColor="@color/status_anomaly"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Need Attention  •  "
                        android:textColor="@color/status_anomaly"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_count_healthy_nodes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:textColor="@color/status_healthy"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Healthy"
                        android:textColor="@color/status_healthy"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Interactive Filter Chips Bar (Triage First, 56dp height touch targets, 12dp spacing) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:background="@color/surface_background"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip_filter_all"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginEnd="12dp"
                    android:text="All Cows (3)"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp"
                    android:backgroundTint="@color/primary_navy"
                    android:textColor="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip_filter_attention"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginEnd="12dp"
                    android:text="🚨 Needs Attention (2)"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp"
                    app:strokeColor="@color/status_anomaly"
                    app:strokeWidth="2dp"
                    android:backgroundTint="@color/surface_card"
                    android:textColor="@color/status_anomaly" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip_filter_fever"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginEnd="12dp"
                    android:text="🌡️ Fever/Calving (1)"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp"
                    app:strokeColor="@color/status_warning"
                    app:strokeWidth="2dp"
                    android:backgroundTint="@color/surface_card"
                    android:textColor="@color/status_warning" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip_filter_strayed"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginEnd="12dp"
                    android:text="🏃 Strayed (1)"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp"
                    app:strokeColor="@color/status_anomaly"
                    app:strokeWidth="2dp"
                    android:backgroundTint="@color/surface_card"
                    android:textColor="@color/status_anomaly" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip_quick_log_milk"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:text="🥛 Log Milk"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp"
                    app:strokeColor="@color/status_healthy"
                    app:strokeWidth="2dp"
                    android:backgroundTint="@color/status_healthy_bg"
                    android:textColor="@color/status_healthy" />
            </LinearLayout>
        </HorizontalScrollView>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content Area: Pull to Refresh & RecyclerView -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Livestock Nodes RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_livestock_nodes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="14dp"
                tools:listitem="@layout/item_livestock_node" />

            <!-- Empty State / Setup Guide View -->
            <LinearLayout
                android:id="@+id/layout_empty_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ic_wifi_gateway"
                    app:tint="@color/text_muted"
                    android:contentDescription="No Data" />

                <TextView
                    android:id="@+id/tv_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/empty_records_title"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_empty_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/empty_records_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_empty_sync"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/btn_sync_now"
                    android:textAllCaps="false"
                    app:cornerRadius="12dp"
                    android:backgroundTint="@color/cta_sync_teal" />

            </LinearLayout>

            <!-- Syncing Progress Indicator Overlay -->
            <LinearLayout
                android:id="@+id/layout_sync_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:background="@drawable/badge_healthy"
                android:backgroundTint="@color/surface_card"
                android:elevation="8dp"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:indeterminateTint="@color/accent_teal" />

                <TextView
                    android:id="@+id/tv_sync_status_msg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/syncing_data"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </FrameLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
