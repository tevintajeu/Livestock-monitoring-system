<?xml version="1.0" encoding="utf-8"?>
<!-- Network Security Config to permit cleartext HTTP communication with ESP32 local gateway -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Default ESP32 SoftAP IP address subnet -->
        <domain includeSubdomains="true">192.168.4.1</domain>
        <domain includeSubdomains="true">192.168.4.*</domain>
        <!-- Fallback for standard local subnet testing -->
        <domain includeSubdomains="true">192.168.1.*</domain>
        <domain includeSubdomains="true">10.0.2.2</domain> <!-- Android Emulator localhost alias -->
    </domain-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
