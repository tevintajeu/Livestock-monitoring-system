<?xml version="1.0" encoding="utf-8"?>
<!-- Network Security Config to permit cleartext HTTP communication with ESP32 local gateway -->
<network-security-config>
    <!-- Base config permits cleartext HTTP across all local subnets (192.168.X.X, 10.X.X.X) for physical hardware testing -->
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="true">
        <!-- Default ESP32 SoftAP IP address -->
        <domain includeSubdomains="true">192.168.4.1</domain>
        <!-- Android Emulator localhost alias -->
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
