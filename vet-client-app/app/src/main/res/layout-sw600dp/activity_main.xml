<?xml version="1.0" encoding="utf-8"?>
<!-- Samsung Tablet Optimized Herd Dashboard Layout (sw600dp) -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background">

    <!-- Top AppBar: Brand Header + Active Role Switcher + Guided Boma Box Sync Card -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_navy"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">

        <!-- Custom Top Bar with Brand Title, Secure Role Badge & Dropdown Menu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_app_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_app_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Smart Herd &amp; Vet Monitor • Tablet Command Station"
                    android:textColor="@color/surface_divider"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Non-Togglable Role Badge: Indicates authenticated persona -->
            <TextView
                android:id="@+id/tv_active_role_badge"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:text="🩺 Field Veterinarian"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_role_vet_badge" />

            <!-- Dropdown Options Menu Button (⋮) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_menu_dropdown"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:text="⋮"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:contentDescription="Options Menu" />
        </LinearLayout>

        <!-- Tablet Guided "Boma Box" Sync Card: Wide 2-Column Banner -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layout_gateway_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <!-- Left Column: Status, Endpoint & Need Help Button -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/img_gateway_status"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_wifi_gateway"
                            app:tint="@color/status_healthy"
                            android:contentDescription="Boma Box Status" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_boma_box_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Boma Receiver: Ready to Sync"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_gateway_endpoint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Target: http://192.168.4.1:8080/data"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp"
                                android:visibility="gone"
                                tools:visibility="visible" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_need_help_connecting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="10dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="6dp"
                            android:text="❓ Need Help?"
                            android:textColor="@color/primary_navy"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_metric_pill" />
                    </LinearLayout>

                    <!-- Primary 56dp CTA Sync Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_sync_gateway"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="12dp"
                        android:text="@string/btn_sync_now"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        app:cornerRadius="12dp"
                        android:backgroundTint="@color/cta_sync_teal"
                        android:textColor="@color/white" />
                </LinearLayout>

                <!-- Divider between sync button and summary -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/surface_divider" />

                <!-- Right Column: Herd Health Statistics Cards for Tablet -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Herd Summary Overview"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp"
                        android:baselineAligned="false">

                        <!-- Total Animals -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:padding="10dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_metric_pill"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_count_total_nodes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3"
                                android:textColor="@color/text_primary"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total Cows"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Needs Attention -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:padding="10dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_summary_danger"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_count_anomaly_nodes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/status_anomaly"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Attention"
                                android:textColor="@color/status_anomaly"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Healthy -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:padding="10dp"
                            android:background="@drawable/bg_summary_healthy"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_count_healthy_nodes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3"
                                android:textColor="@color/status_healthy"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Healthy"
                                android:textColor="@color/status_healthy"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Interactive Filter Chips Bar -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:background="@color/surface_background"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip_filter_all"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginEnd="12dp"
                    android:text="All Cows"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp"
                    android:backgroundTint="@color/primary_navy"
                    android:textColor="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip_filter_attention"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginEnd="12dp"
                    android:text="🚨 Needs Attention"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp"
                    app:strokeColor="@color/status_anomaly"
                    app:strokeWidth="2dp"
                    android:backgroundTint="@color/surface_card"
                    android:textColor="@color/status_anomaly" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip_filter_fever"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginEnd="12dp"
                    android:text="🌡️ Fever / Calving"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp"
                    app:strokeColor="@color/status_warning"
                    app:strokeWidth="2dp"
                    android:backgroundTint="@color/surface_card"
                    android:textColor="@color/status_warning" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip_filter_strayed"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginEnd="12dp"
                    android:text="🏃 Strayed Geofence"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp"
                    app:strokeColor="@color/status_anomaly"
                    app:strokeWidth="2dp"
                    android:backgroundTint="@color/surface_card"
                    android:textColor="@color/status_anomaly" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip_quick_log_milk"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:text="🥛 Log Milk Output"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp"
                    app:strokeColor="@color/status_healthy"
                    app:strokeWidth="2dp"
                    android:backgroundTint="@color/status_healthy_bg"
                    android:textColor="@color/status_healthy" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Active Filter Indicator Bar -->
        <LinearLayout
            android:id="@+id/layout_active_filter_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/surface_subtle"
            android:paddingStart="24dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_active_filter_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Showing: Needs Attention (2)" />

            <TextView
                android:id="@+id/btn_clear_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="✕ Clear Filter"
                android:textColor="@color/status_anomaly"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Non-Blocking Sync Progress Banner -->
        <LinearLayout
            android:id="@+id/layout_sync_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingTop="10dp"
            android:paddingEnd="24dp"
            android:paddingBottom="10dp"
            android:background="@color/primary_light"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/white" />

            <TextView
                android:id="@+id/tv_sync_status_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:text="Syncing telemetry from Boma Gateway..." />
        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content Area: Responsive Multi-Column Grid of Livestock Cards -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="8dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_livestock_nodes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="48dp" />

            <!-- Empty Herd State -->
            <LinearLayout
                android:id="@+id/layout_empty_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:src="@drawable/ic_wifi_gateway"
                    app:tint="@color/text_muted"
                    android:contentDescription="Empty State" />

                <TextView
                    android:id="@+id/tv_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="No Telemetry Received Yet"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_empty_desc"
                    android:layout_width="400dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Connect your tablet to Wi-Fi 'ESP32_LIVESTOCK_AP' (Pass: 12345678) and tap 'Sync from Boma Receiver'."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_empty_sync"
                    android:layout_width="280dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    android:text="Sync from Boma Receiver"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    android:backgroundTint="@color/cta_sync_teal"
                    android:textColor="@color/white" />
            </LinearLayout>

        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
